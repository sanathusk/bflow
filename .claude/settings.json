{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bflow guard --post",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bflow guard --reads",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Task|Agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bflow hook session-start",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bflow hook tokens",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bflow hook tokens",
            "timeout": 20,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bflow hook subagent-stop",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "bflow-.*"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bflow *)"
    ]
  },
  "statusLine": {
    "command": "bflow statusline",
    "type": "command"
  }
}
